[Unit]
Description=Subliminal Cart Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/subliminal-cart3l
EnvironmentFile=/opt/subliminal-cart3l/.env
ExecStart=/opt/subliminal-cart3l/.venv/bin/python /opt/subliminal-cart3l/bot.py
Restart=always
RestartSec=5
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
